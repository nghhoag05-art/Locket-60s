#!name=Locket Only 60s - HuyHoang Full
#!desc=Locket ONLY: full remote-config/captions; 60s requested (subject to Locket server limits).

[Script]
# Locket Gold-style subscriber display logic (not a verified subscription)
locket_receipt_60s = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/nghhoag05-art/Locket-Custom-Personal-huyhoang/refs/heads/main/scripts/locketfix8_60s_full.js, requires-body=true, max-size=-1, timeout=60
locket_header_60s = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/nghhoag05-art/Locket-Custom-Personal-huyhoang/refs/heads/main/scripts/header7_60s_full.js, timeout=60
# Firebase Locket (all original settings, custom captions; video config set to 60 seconds)
locket_config_60s = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/nghhoag05-art/Locket-Custom-Personal-huyhoang/refs/heads/main/scripts/forceGold4.3_60s_full.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
